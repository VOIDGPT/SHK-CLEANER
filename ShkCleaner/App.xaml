<Application x:Class="ShkCleaner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ================================================================ -->
            <!-- ЦВЕТА ТЕМЫ (кисти). Значения по умолчанию - ТЁМНАЯ тема.          -->
            <!-- При смене темы код (SettingsManager) просто заменяет эти кисти,   -->
            <!-- а интерфейс мгновенно перекрашивается, т.к. везде используется      -->
            <!-- DynamicResource.                                                   -->
            <!-- ================================================================ -->
            <SolidColorBrush x:Key="ФонБраш" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="ФонПанелиБраш" Color="#171717"/>
            <SolidColorBrush x:Key="ФонКарточкиБраш" Color="#252526"/>
            <SolidColorBrush x:Key="ТекстБраш" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ТекстВторичныйБраш" Color="#A0A0A0"/>
            <SolidColorBrush x:Key="АкцентБраш" Color="#007ACC"/>
            <SolidColorBrush x:Key="ГраницаБраш" Color="#333333"/>
            <!-- Зелёный акцент (успех/освобождено) и мягкий фон для чипов-подсказок -->
            <SolidColorBrush x:Key="ЗелёныйБраш" Color="#4CAF50"/>
            <SolidColorBrush x:Key="ЧипБраш" Color="#2F2F33"/>

            <!-- ================================================================ -->
            <!-- ГРАДИЕНТ ЛОГОТИПА (металлик-синий) - используется в сайдбаре     -->
            <!-- и на странице "О программе".                                     -->
            <!-- ================================================================ -->
            <LinearGradientBrush x:Key="ЛоготипГрадиент" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#007ACC" Offset="0"/>
                <GradientStop Color="#2E8FD6" Offset="0.55"/>
                <GradientStop Color="#4CAF50" Offset="1"/>
            </LinearGradientBrush>

            <!-- ================================================================ -->
            <!-- СТИЛЬ ОБЫЧНОЙ КНОПКИ: закруглённые углы + анимация при наведении  -->
            <!-- ================================================================ -->
            <Style x:Key="КнопкаСтиль" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource АкцентБраш}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="18,9"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- Border с CornerRadius = "закруглённые углы" (8 px) -->
                            <Border x:Name="Рамка"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Анимация плавного изменения цвета при наведении мыши -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Рамка"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#2299E0" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="Рамка"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#007ACC" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <!-- Когда кнопка неактивна - делаем её полупрозрачной -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Рамка" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Красная кнопка (для опасных действий: удалить) -->
            <Style x:Key="КнопкаОпаснаяСтиль" TargetType="Button" BasedOn="{StaticResource КнопкаСтиль}">
                <Setter Property="Background" Value="#C42B1C"/>
            </Style>

            <!-- Серая кнопка (второстепенные действия) -->
            <Style x:Key="КнопкаСераяСтиль" TargetType="Button" BasedOn="{StaticResource КнопкаСтиль}">
                <Setter Property="Background" Value="{DynamicResource ФонКарточкиБраш}"/>
                <Setter Property="Foreground" Value="{DynamicResource ТекстБраш}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ГраницаБраш}"/>
            </Style>

            <!-- ================================================================ -->
            <!-- КНОПКА БОКОВОЙ НАВИГАЦИИ                                          -->
            <!-- ================================================================ -->
            <Style x:Key="НавигацияКнопкаСтиль" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource ТекстВторичныйБраш}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Рамка" CornerRadius="8" Margin="8,2" Padding="14,11"
                                    Background="Transparent">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Подсветка при наведении -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Рамка" Property="Background" Value="#2A2D31"/>
                                </Trigger>
                                <!-- Активная (выбранная) кнопка - синяя плашка -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Рамка" Property="Background" Value="{DynamicResource АкцентБраш}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================================================================ -->
            <!-- БАЗОВЫЕ СТИЛИ ТЕКСТА / ЧЕКБОКСОВ / РАДИО / ПОЛЕЙ ВВОДА            -->
            <!-- ================================================================ -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource ТекстБраш}"/>
            </Style>

            <Style x:Key="ЗаголовокСтраницы" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{DynamicResource ТекстБраш}"/>
            </Style>

            <Style x:Key="ПодзаголовокСтраницы" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{DynamicResource ТекстВторичныйБраш}"/>
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource ТекстБраш}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,6"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource ТекстБраш}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,5"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource ФонКарточкиБраш}"/>
                <Setter Property="Foreground" Value="{DynamicResource ТекстБраш}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ГраницаБраш}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource ТекстБраш}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="10,7"/>
            </Style>

            <!-- Карточка-контейнер с закруглением и рамкой -->
            <Style x:Key="КарточкаСтиль" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ФонКарточкиБраш}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ГраницаБраш}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="18"/>
            </Style>

            <!-- ================================================================ -->
            <!-- DATAGRID (таблица программ) в тёмном стиле                        -->
            <!-- ================================================================ -->
            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="{DynamicResource ФонКарточкиБраш}"/>
                <Setter Property="Foreground" Value="{DynamicResource ТекстБраш}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ГраницаБраш}"/>
                <Setter Property="RowBackground" Value="Transparent"/>
                <Setter Property="AlternatingRowBackground" Value="#2D2D31"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ГраницаБраш}"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="RowHeight" Value="40"/>
            </Style>

            <!-- Строка таблицы: лёгкая подсветка под курсором мыши -->
            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#3329292D"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource ФонПанелиБраш}"/>
                <Setter Property="Foreground" Value="{DynamicResource ТекстВторичныйБраш}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ГраницаБраш}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>

            <Style TargetType="DataGridCell">
                <Setter Property="Foreground" Value="{DynamicResource ТекстБраш}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,4"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource АкцентБраш}"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Прогресс-бар: синяя полоска на тёмном фоне, скругление -->
            <Style TargetType="ProgressBar">
                <Setter Property="Background" Value="{DynamicResource ФонПанелиБраш}"/>
                <Setter Property="Foreground" Value="{DynamicResource АкцентБраш}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ГраницаБраш}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Height" Value="10"/>
            </Style>

            <!-- Скроллбар тонкий, чтобы не портил тёмный дизайн -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="10"/>
            </Style>

            <!-- ================================================================ -->
            <!-- КАРТОЧКА СТАТИСТИКИ (плитки "Всего мусора", "Освобождено" и т.п.) -->
            <!-- Внутрь кладётся StackPanel: TextBlock x:Name="Значение" + подпись  -->
            <!-- ================================================================ -->
            <Style x:Key="СтатистикаКарточка" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ФонКарточкиБраш}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ГраницаБраш}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="Margin" Value="0,0,12,0"/>
            </Style>

            <!-- Цветной "чип" (например бейдж "Тихое удаление доступно") -->
            <Style x:Key="ЧипСтиль" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ЧипБраш}"/>
                <Setter Property="CornerRadius" Value="999"/>
                <Setter Property="Padding" Value="10,4"/>
            </Style>

            <!-- Карточка-контейнер с анимацией подсветки рамки при наведении -->
            <Style x:Key="КарточкаХоверСтиль" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ФонКарточкиБраш}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ГраницаБраш}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="8"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource АкцентБраш}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ================================================================ -->
            <!-- КОНВЕРТАРЫ ДЛЯ ИНТЕРФЕЙСА                                        -->
            <!-- Инверсия bool: true -> Collapsed (скрыть), false -> Visible      -->
            <!-- Используется для картинки-заглушки, пока миниатюра не загружена. -->
            <!-- ================================================================ -->
            <local:InverseBoolToVisibilityConverter x:Key="InvBool"
                    xmlns:local="clr-namespace:ShkCleaner"/>

            <!-- Прямая инверсия предыдущего: true -> Visible, false -> Collapsed -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
