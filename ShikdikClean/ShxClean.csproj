<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF приложение, целевая платформа - .NET 9 для Windows -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Позволяет собирать проект даже на не-Windows системах (для проверки кода) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Манифест с требованием прав администратора -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Информация о сборке (версия отображается на странице "О программе") -->
    <AssemblyName>SHX Clean</AssemblyName>
    <RootNamespace>ShxClean</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>SHX</Authors>
    <Product>SHX Clean</Product>
    </PropertyGroup>

  <!-- Иконка самого .exe файла в проводнике Windows (это свойство, НЕ элемент ItemGroup) -->
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Картинки логотипа, используемые внутри интерфейса (Resource = вшита в exe).
         Замените appicon_256.png на свою картинку (PNG, 256x256), чтобы сменить логотип. -->
    <Resource Include="Resources\appicon_256.png" />
    <Resource Include="Resources\appicon_48.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.VisualBasic (нужен для FileSystem.DeleteFile -> удаление в Корзину)
         входит в состав .NET для Windows, PackageReference НЕ требуется -->
  </ItemGroup>

  <ItemGroup>
    <!-- Убираем предупреждение о "неиспользуемом" VisualBasic при компиляции на не-Windows -->
    <FrameworkReference Update="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Файл настроек копируется в выходную директорию -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
