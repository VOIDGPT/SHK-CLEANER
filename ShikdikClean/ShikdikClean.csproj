<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF приложение, целевая платформа - .NET 9 для Windows -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Манифест с требованием прав администратора -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Информация о сборке (версия отображается на странице "О программе") -->
    <AssemblyName>Shikdik Clean</AssemblyName>
    <RootNamespace>ShikdikClean</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Shikdik</Authors>
    <Product>Shikdik Clean</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Нужен для Microsoft.VisualBasic.FileIO (удаление файлов в Корзину) -->
    <PackageReference Include="Microsoft.VisualBasic" Version="10.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Файл настроек копируется в выходную директорию -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
